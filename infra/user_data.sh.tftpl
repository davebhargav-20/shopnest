#!/bin/bash
# Runs once at first boot of the ShopNest EC2 instance (Amazon Linux 2023)
set -euo pipefail   # no -x: the DB password must not reach the boot log

dnf update -y
dnf install -y docker cronie
systemctl enable --now docker crond

# Docker Compose v2 plugin
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# 1 GB swap: helps the 1 GiB t3.micro during image pulls
if [ ! -f /swapfile ]; then
  fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi

mkdir -p /opt/shopnest/uploads
cd /opt/shopnest
echo '${compose_b64}'   | base64 -d > docker-compose.prod.yml
echo '${caddyfile_b64}' | base64 -d > Caddyfile
echo '${deploy_sh_b64}' | base64 -d > deploy.sh
echo '${backup_sh_b64}' | base64 -d > backup.sh
chmod 750 deploy.sh backup.sh

DB_PASS=$(aws ssm get-parameter --region ${aws_region} --name '${db_pass_param}' --with-decryption --query Parameter.Value --output text)
cat > .env <<ENV
AWS_REGION=${aws_region}
ECR_IMAGE=${ecr_image}
APP_TAG=latest
DB_HOST=${db_host}
DB_USER=${db_user}
DB_PASS=$DB_PASS
DB_NAME=${db_name}
SITE_ADDRESS=${site_address}
BACKUP_BUCKET=${backup_bucket}
ENV
chmod 600 .env

# Nightly backup at 21:00 UTC = 02:30 IST
echo '0 21 * * * root /opt/shopnest/backup.sh >> /var/log/shopnest-backup.log 2>&1' > /etc/cron.d/shopnest-backup

# First start (succeeds once the pipeline has pushed an image; until then the pipeline deploys)
./deploy.sh latest || echo "No image yet: push to main to deploy."
